# Search provider: auto, google, serper, or tavily.
# Auto selects the first configured provider in the order Google, Serper, Tavily.
SEARCH_PROVIDER=auto

# Google Programmable Search (existing customers only).
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Serper Google Search API.
SERPER_API_KEY=

# Tavily Search API. Tavily reports the number of returned matches, not a
# web-wide result estimate.
TAVILY_API_KEY=

# LangChain-powered word suggestions (alongside Datamuse) for the thesaurus expansion.
ANTHROPIC_API_KEY=

# Stripe Checkout for one-time PLN credit packs (card + BLIK).
STRIPE_SECRET_KEY=
# Required outside local development, for example https://domainmate.app
APP_URL=

# Optional registrar quotes. Porkbun TLD list pricing works without credentials.
# GoDaddy Domains v3 requires a Personal Access Token with domain read scope.
# NameSilo and Dynadot use account API keys for their official pricing APIs.
GODADDY_PAT=
NAMESILO_API_KEY=
DYNADOT_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_REGISTRAR_TOKEN=
PORT=3000

# Hosted persistence. Set both in Vercel to fan writes out to Supabase and Neon.
# Use pooled connection strings; these values are server-only and must never use a NUXT_PUBLIC_ prefix.
SUPABASE_DATABASE_URL=
NEON_DATABASE_URL=

# Shared secret guarding /admin/analytics and /api/admin/analytics. Required to
# view the analytics dashboard; the endpoint refuses all requests if unset.
ADMIN_TOKEN=

# Browser PostHog SDK (public project token and ingestion host). Product events
# are captured client-side only; there is no server-side PostHog capture, to avoid
# double-counting the same event from both sides.
NUXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NUXT_PUBLIC_POSTHOG_HOST=

# Vercel Web Analytics (page views) is wired in automatically via the
# @vercel/analytics Nuxt module; no env vars needed. Custom product events also
# forward to it server-side, using the VERCEL_URL Vercel sets automatically.
